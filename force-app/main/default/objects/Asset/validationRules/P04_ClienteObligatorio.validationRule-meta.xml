    <fullName>P04_ClienteObligatorio</fullName>
    <active>true</active>
    <description>Ámbito exclusivo del Proyecto 04.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "P04_Producto", ISBLANK(AccountId))</errorConditionFormula>
