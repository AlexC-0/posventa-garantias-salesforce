<?xml version="1.0" encoding="utf-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>P04_IntervaloGarantia</fullName>
    <active>true</active>
    <description>Ámbito exclusivo del Proyecto 04.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "P04_Producto", AND(NOT(ISBLANK(P04_InicioGarantia__c)), NOT(ISBLANK(P04_FinGarantia__c)), P04_FinGarantia__c &lt; P04_InicioGarantia__c))</errorConditionFormula>
    <errorDisplayField>P04_FinGarantia__c</errorDisplayField>
    <errorMessage>P04: el fin de garantía no puede ser anterior al inicio.</errorMessage>
</ValidationRule>