            <targetReference>Rechazo</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No guardada</defaultConnectorLabel>
        <rules>
            <name>Guardada</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
